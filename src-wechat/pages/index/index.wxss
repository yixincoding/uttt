.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 20px;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20px;
}

.title {
  font-size: 24px;
  font-weight: bold;
  color: #333333;
}

.reset-btn {
  background: #ffffff;
  border: 1px solid #e5e5e5;
  border-radius: 8px;
  padding: 8px 16px;
  font-size: 14px;
  color: #333333;
}

.mode-bar {
  background: #ffffff;
  border-radius: 12px;
  padding: 16px;
  margin-bottom: 16px;
}

.mode-section,
.difficulty-section {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8px;
  margin-bottom: 12px;
}

.mode-label {
  color: #333333;
  font-size: 14px;
  margin-right: 4px;
}

.mode-btn,
.diff-btn {
  background: #f5f5f5;
  border: 1px solid #e5e5e5;
  border-radius: 8px;
  padding: 8px 16px;
  font-size: 14px;
  color: #888888;
}

.mode-btn.active,
.diff-btn.active {
  background: #6366f1;
  border-color: #6366f1;
  color: #ffffff;
}

.start-btn {
  width: 100%;
  background: #6366f1;
  border: none;
  border-radius: 8px;
  padding: 12px;
  font-size: 16px;
  font-weight: bold;
  color: #ffffff;
  margin-top: 8px;
}

.start-btn.disabled {
  background: #cccccc;
  color: #888888;
}

.info-bar {
  background: #ffffff;
  border-radius: 8px;
  padding: 12px 16px;
  margin-bottom: 16px;
}

.info-text {
  color: #888888;
  font-size: 14px;
  text-align: center;
}

.status-text {
  display: block;
  text-align: center;
  font-size: 16px;
  font-weight: bold;
  color: #333333;
  margin-bottom: 16px;
}

.login-btn {
  width: 100%;
  background: #22c55e;
  border: none;
  border-radius: 8px;
  padding: 14px;
  font-size: 16px;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 20px;
}

.meta-board {
  display: flex;
  flex-direction: column;
  gap: 8px;
  max-width: 400px;
  margin: 0 auto;
}

.small-board-row {
  display: flex;
  flex-direction: row;
  gap: 8px;
}

.small-board {
  flex: 1;
  aspect-ratio: 1;
  background: #ffffff;
  border-radius: 12px;
  border: 2px solid #e5e5e5;
  position: relative;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  padding: 4px;
  box-sizing: border-box;
}

.small-board.active {
  border-color: #6366f1;
  box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.2);
}

.small-board.won-x {
  border-color: #ef4444;
  background: rgba(239, 68, 68, 0.1);
}

.small-board.won-o {
  border-color: #3b82f6;
  background: rgba(59, 130, 246, 0.1);
}

.small-board.draw {
  border-color: #888888;
  background: rgba(136, 136, 136, 0.1);
}

.cells-grid {
  display: flex;
  flex-direction: column;
  gap: 2px;
  flex: 1;
}

.cell-row {
  display: flex;
  gap: 2px;
  flex: 1;
}

.cell {
  flex: 1;
  background: #f5f5f5;
  border: none;
  border-radius: 4px;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  margin: 0;
}

.cell-text {
  font-size: 20px;
  font-weight: bold;
}

.x-mark {
  color: #ef4444;
}

.o-mark {
  color: #3b82f6;
}

.winner-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
}

.winner-text {
  font-size: 48px;
  font-weight: bold;
  opacity: 0.15;
}

.cell.disabled {
  background: #e5e5e5;
  opacity: 0.6;
}

/* ========== Rules Modal ========== */

.rules-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.7);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.rules-content {
  background: #ffffff;
  border-radius: 16px;
  width: 90%;
  max-width: 340px;
  max-height: 85vh;
  overflow-y: auto;
  padding: 24px;
}

.rules-title {
  display: block;
  text-align: center;
  font-size: 20px;
  font-weight: bold;
  color: #333333;
  margin-bottom: 20px;
}

.rules-section {
  margin-bottom: 20px;
}

.rules-heading {
  display: block;
  font-size: 15px;
  font-weight: 600;
  color: #333333;
  margin-bottom: 8px;
}

.rules-text {
  display: block;
  font-size: 13px;
  color: #666666;
  line-height: 1.5;
  margin-bottom: 12px;
}

.rules-caption {
  display: block;
  font-size: 11px;
  color: #999999;
  text-align: center;
  margin-top: 8px;
}

.rules-caption.red {
  color: #ef4444;
  font-weight: 600;
}

.rules-btn {
  width: 100%;
  background: #6366f1;
  border: none;
  border-radius: 8px;
  padding: 14px;
  font-size: 16px;
  font-weight: bold;
  color: #ffffff;
  margin-top: 16px;
}

/* Rules Diagrams */

.meta-board-visual {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
}

.meta-row {
  display: flex;
  flex-direction: row;
  gap: 4px;
}

.mini-board {
  width: 36px;
  height: 36px;
  background: #f5f5f5;
  border: 1px solid #e5e5e5;
  border-radius: 4px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.mini-board.won {
  background: rgba(239, 68, 68, 0.1);
  border-color: rgba(239, 68, 68, 0.3);
}

.mini-board.won-x {
  background: rgba(239, 68, 68, 0.1);
  border: 2px solid #ef4444;
}

.mini-board.wildcard {
  background: rgba(99, 102, 241, 0.1);
  border: 2px solid #6366f1;
}

.mini-cell-text {
  font-size: 12px;
  font-weight: 600;
  color: #888888;
}

.mini-cell-text.won-x {
  color: #ef4444;
}

.mini-cell-text.wildcard {
  color: #6366f1;
  font-weight: bold;
}

/* Move Diagram */

.move-diagram {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 12px;
}

.cell-indices {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.index-row {
  display: flex;
  flex-direction: row;
  gap: 2px;
}

.index-cell {
  width: 28px;
  height: 28px;
  background: #f5f5f5;
  border: 1px solid #e5e5e5;
  border-radius: 4px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 11px;
  color: #cccccc;
}

.index-cell.active {
  background: rgba(99, 102, 241, 0.1);
  border-color: #6366f1;
  color: #6366f1;
  font-weight: 600;
}

.arrow {
  font-size: 16px;
  color: #cccccc;
}

.target-board {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.target-row {
  display: flex;
  flex-direction: row;
  gap: 2px;
}

.target-cell {
  width: 28px;
  height: 28px;
  background: #f5f5f5;
  border: 1px solid #e5e5e5;
  border-radius: 4px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 12px;
  font-weight: 600;
  color: #888888;
}

.target-cell.highlight {
  background: rgba(99, 102, 241, 0.1);
  border: 2px solid #6366f1;
  color: #6366f1;
}

/* Wildcard Diagram */

.wildcard-diagram {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
}

/* Single Board Diagram */

.single-board-diagram {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2px;
}

.board-row {
  display: flex;
  flex-direction: row;
  gap: 2px;
}

.board-cell {
  width: 32px;
  height: 32px;
  background: #f5f5f5;
  border: 1px solid #e5e5e5;
  border-radius: 4px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.board-cell.win {
  background: rgba(239, 68, 68, 0.1);
  border-color: #ef4444;
}

.board-cell.win-center {
  background: rgba(239, 68, 68, 0.1);
  border: 2px solid #ef4444;
}

.cell-mark {
  font-size: 14px;
  font-weight: bold;
}

/* Win Diagram */

.win-diagram {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
}
