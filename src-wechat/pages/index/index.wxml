<view class="container">
  <view class="header">
    <text class="title">TEN</text>
    <button class="reset-btn" bindtap="onReset">Reset</button>
  </view>

  <view class="mode-bar" wx:if="{{phase === 'setup'}}">
    <view class="mode-section">
      <text class="mode-label">Mode:</text>
      <button 
        class="mode-btn {{selectedMode === '2p' ? 'active' : ''}}" 
        bindtap="onSelectMode" 
        data-mode="2p">2 Player</button>
      <button 
        class="mode-btn {{selectedMode === 'ai' ? 'active' : ''}}" 
        bindtap="onSelectMode" 
        data-mode="ai">vs AI</button>
    </view>

    <view class="difficulty-section" wx:if="{{selectedMode === 'ai'}}">
      <text class="mode-label">Difficulty:</text>
      <button 
        class="diff-btn {{selectedDifficulty === 'simple' ? 'active' : ''}}" 
        bindtap="onSelectDifficulty" 
        data-difficulty="simple">Simple</button>
      <button 
        class="diff-btn {{selectedDifficulty === 'median' ? 'active' : ''}}" 
        bindtap="onSelectDifficulty" 
        data-difficulty="median">Median</button>
      <button 
        class="diff-btn {{selectedDifficulty === 'hard' ? 'active' : ''}}" 
        bindtap="onSelectDifficulty" 
        data-difficulty="hard">Hard</button>
    </view>

    <button 
      class="start-btn {{selectedMode ? '' : 'disabled'}}" 
      bindtap="onStart"
      disabled="{{!selectedMode}}">Start Game</button>
  </view>

  <view class="info-bar" wx:if="{{phase !== 'setup'}}">
    <text class="info-text">{{selectedMode === 'ai' ? 'AI' : '2P'}} · {{selectedDifficulty}}</text>
  </view>

  <text class="status-text">{{statusText}}</text>

  <view class="meta-board" wx:if="{{gameState}}">
    <view class="small-board-row" wx:for="{{3}}" wx:for-index="row">
      <view 
        class="small-board {{getSmallBoardClass(row * 3 + col)}}" 
        wx:for="{{3}}" 
        wx:for-index="col">
        <view class="cells-grid">
          <view class="cell-row">
            <button class="cell {{getCellClass(row * 3 + col, 0)}}" bindtap="onCellTap" data-board="{{row * 3 + col}}" data-cell="0" disabled="{{getCellDisabled(row * 3 + col, 0)}}">
              <text class="cell-text">{{getCellValue(row * 3 + col, 0)}}</text>
            </button>
            <button class="cell {{getCellClass(row * 3 + col, 1)}}" bindtap="onCellTap" data-board="{{row * 3 + col}}" data-cell="1" disabled="{{getCellDisabled(row * 3 + col, 1)}}">
              <text class="cell-text">{{getCellValue(row * 3 + col, 1)}}</text>
            </button>
            <button class="cell {{getCellClass(row * 3 + col, 2)}}" bindtap="onCellTap" data-board="{{row * 3 + col}}" data-cell="2" disabled="{{getCellDisabled(row * 3 + col, 2)}}">
              <text class="cell-text">{{getCellValue(row * 3 + col, 2)}}</text>
            </button>
          </view>
          <view class="cell-row">
            <button class="cell {{getCellClass(row * 3 + col, 3)}}" bindtap="onCellTap" data-board="{{row * 3 + col}}" data-cell="3" disabled="{{getCellDisabled(row * 3 + col, 3)}}">
              <text class="cell-text">{{getCellValue(row * 3 + col, 3)}}</text>
            </button>
            <button class="cell {{getCellClass(row * 3 + col, 4)}}" bindtap="onCellTap" data-board="{{row * 3 + col}}" data-cell="4" disabled="{{getCellDisabled(row * 3 + col, 4)}}">
              <text class="cell-text">{{getCellValue(row * 3 + col, 4)}}</text>
            </button>
            <button class="cell {{getCellClass(row * 3 + col, 5)}}" bindtap="onCellTap" data-board="{{row * 3 + col}}" data-cell="5" disabled="{{getCellDisabled(row * 3 + col, 5)}}">
              <text class="cell-text">{{getCellValue(row * 3 + col, 5)}}</text>
            </button>
          </view>
          <view class="cell-row">
            <button class="cell {{getCellClass(row * 3 + col, 6)}}" bindtap="onCellTap" data-board="{{row * 3 + col}}" data-cell="6" disabled="{{getCellDisabled(row * 3 + col, 6)}}">
              <text class="cell-text">{{getCellValue(row * 3 + col, 6)}}</text>
            </button>
            <button class="cell {{getCellClass(row * 3 + col, 7)}}" bindtap="onCellTap" data-board="{{row * 3 + col}}" data-cell="7" disabled="{{getCellDisabled(row * 3 + col, 7)}}">
              <text class="cell-text">{{getCellValue(row * 3 + col, 7)}}</text>
            </button>
            <button class="cell {{getCellClass(row * 3 + col, 8)}}" bindtap="onCellTap" data-board="{{row * 3 + col}}" data-cell="8" disabled="{{getCellDisabled(row * 3 + col, 8)}}">
              <text class="cell-text">{{getCellValue(row * 3 + col, 8)}}</text>
            </button>
          </view>
        </view>
        <view class="winner-overlay" wx:if="{{getSmallBoardWinner(row * 3 + col)}}">
          <text class="winner-text {{getSmallBoardWinner(row * 3 + col) === 'x' ? 'x-mark' : 'o-mark'}}">{{getSmallBoardWinner(row * 3 + col) === 'x' ? 'X' : 'O'}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- Rules Modal -->
  <view class="rules-modal" wx:if="{{showRules}}">
    <view class="rules-content">
      <text class="rules-title">How to Play</text>
      
      <!-- Section 1: The Board -->
      <view class="rules-section">
        <text class="rules-heading">1. The Board</text>
        <text class="rules-text">TEN is played on a meta-board of 9 small boards. Each board contains 9 cells (3×3). That's 81 cells total.</text>
        <view class="meta-board-visual">
          <view class="meta-row">
            <view class="mini-board"><text class="mini-cell-text">0</text></view>
            <view class="mini-board"><text class="mini-cell-text">1</text></view>
            <view class="mini-board"><text class="mini-cell-text">2</text></view>
          </view>
          <view class="meta-row">
            <view class="mini-board"><text class="mini-cell-text">3</text></view>
            <view class="mini-board"><text class="mini-cell-text">4</text></view>
            <view class="mini-board"><text class="mini-cell-text">5</text></view>
          </view>
          <view class="meta-row">
            <view class="mini-board"><text class="mini-cell-text">6</text></view>
            <view class="mini-board"><text class="mini-cell-text">7</text></view>
            <view class="mini-board"><text class="mini-cell-text">8</text></view>
          </view>
        </view>
        <text class="rules-caption">The 9 small boards numbered 0-8</text>
      </view>

      <!-- Section 2: Your Move -->
      <view class="rules-section">
        <text class="rules-heading">2. Your Move</text>
        <text class="rules-text">Play in any empty cell of the active board. The position you play determines which board your opponent must play in next.</text>
        <view class="move-diagram">
          <view class="cell-indices">
            <view class="index-row">
              <view class="index-cell active">0</view>
              <view class="index-cell">1</view>
              <view class="index-cell">2</view>
            </view>
            <view class="index-row">
              <view class="index-cell active">3</view>
              <view class="index-cell">4</view>
              <view class="index-cell">5</view>
            </view>
            <view class="index-row">
              <view class="index-cell">6</view>
              <view class="index-cell">7</view>
              <view class="index-cell">8</view>
            </view>
          </view>
          <text class="arrow">→</text>
          <view class="target-board">
            <view class="target-row">
              <view class="target-cell"></view>
              <view class="target-cell"></view>
              <view class="target-cell"></view>
            </view>
            <view class="target-row">
              <view class="target-cell"></view>
              <view class="target-cell highlight">4</view>
              <view class="target-cell"></view>
            </view>
            <view class="target-row">
              <view class="target-cell"></view>
              <view class="target-cell"></view>
              <view class="target-cell"></view>
            </view>
          </view>
        </view>
        <text class="rules-caption">Play cell 3 → opponent goes to board 3</text>
      </view>

      <!-- Section 3: Wildcard -->
      <view class="rules-section">
        <text class="rules-heading">3. The Wildcard Rule</text>
        <text class="rules-text">If you're sent to a board that's already been won or is full, you can play in ANY available cell on the meta-board!</text>
        <view class="wildcard-diagram">
          <view class="meta-row">
            <view class="mini-board won"><text class="mini-cell-text won-x">X</text></view>
            <view class="mini-board won"><text class="mini-cell-text won-x">X</text></view>
            <view class="mini-board won"><text class="mini-cell-text won-x">X</text></view>
          </view>
          <view class="meta-row">
            <view class="mini-board"></view>
            <view class="mini-board"></view>
            <view class="mini-board"></view>
          </view>
          <view class="meta-row">
            <view class="mini-board wildcard"><text class="mini-cell-text wildcard">?</text></view>
            <view class="mini-board"></view>
            <view class="mini-board"></view>
          </view>
        </view>
        <text class="rules-caption">Board 0 is won. Player sent here → play anywhere!</text>
      </view>

      <!-- Section 4: Winning a Board -->
      <view class="rules-section">
        <text class="rules-heading">4. Winning a Board</text>
        <text class="rules-text">Get 3 of your marks in a row within a small board to win it. Rows, columns, and diagonals all count.</text>
        <view class="single-board-diagram">
          <view class="board-row">
            <view class="board-cell win"><text class="cell-mark x-mark">X</text></view>
            <view class="board-cell"></view>
            <view class="board-cell win"><text class="cell-mark x-mark">X</text></view>
          </view>
          <view class="board-row">
            <view class="board-cell"></view>
            <view class="board-cell win-center"><text class="cell-mark x-mark">X</text></view>
            <view class="board-cell"></view>
          </view>
          <view class="board-row">
            <view class="board-cell win"><text class="cell-mark x-mark">X</text></view>
            <view class="board-cell"></view>
            <view class="board-cell"></view>
          </view>
        </view>
        <text class="rules-caption red">X wins this board!</text>
      </view>

      <!-- Section 5: Winning the Game -->
      <view class="rules-section">
        <text class="rules-heading">5. Winning the Game</text>
        <text class="rules-text">Win the game by claiming 3 small boards in a row on the meta-board (horizontal, vertical, or diagonal).</text>
        <view class="win-diagram">
          <view class="meta-row">
            <view class="mini-board won-x"><text class="mini-cell-text">X</text></view>
            <view class="mini-board won-x"><text class="mini-cell-text">X</text></view>
            <view class="mini-board"></view>
          </view>
          <view class="meta-row">
            <view class="mini-board"></view>
            <view class="mini-board"></view>
            <view class="mini-board"></view>
          </view>
          <view class="meta-row">
            <view class="mini-board"></view>
            <view class="mini-board"></view>
            <view class="mini-board won-x"><text class="mini-cell-text">X</text></view>
          </view>
        </view>
        <text class="rules-caption red">X wins the diagonal!</text>
      </view>

      <!-- Section 6: Draw -->
      <view class="rules-section">
        <text class="rules-heading">6. Draw</text>
        <text class="rules-text">If all 81 cells are filled and no player has won 3 boards in a row, the game is a draw.</text>
      </view>

      <button class="rules-btn" bindtap="onCloseRules">Got it!</button>
    </view>
  </view>
</view>
